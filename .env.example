# Copy to `.env.local` and fill in to enable real Apple / Google sign-in.
# Only VITE_-prefixed variables reach the browser, which is correct: these are
# PUBLIC client identifiers.
#
# Never put a client secret, an Apple .p8 key, or any signing key in this file
# or anywhere else in the app. Anything bundled into the client is readable by
# anyone who opens the site. Token exchange and verification belong on a server.

# ── Sign in with Apple ────────────────────────────────────────────────────
# Needs a paid Apple Developer Program membership.
# Create a Services ID (not an App ID) and enable "Sign in with Apple" on it.
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=

# ── Sign in with Google ───────────────────────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# Add the redirect URI below to the client's allowed redirect list.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=
